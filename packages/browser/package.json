{
  "name": "@ncrawl/browser",
  "version": "0.1.0",
  "private": true,
  "description": "NCrawl Browser — local Playwright/Chromium runtime for authorized inspection",
  "type": "module",
  "bin": {
    "ncrawl-browser": "./src/cli.ts",
    "ncrawl-browser-mcp": "./src/mcp/server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "cli": "node src/cli.ts",
    "contracts": "node src/contracts/generate.ts",
    "contracts:check": "node src/contracts/generate.ts --check",
    "mcp": "node src/mcp/server.ts"
  },
  "dependencies": {
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ncrawl/mock-erp": "0.1.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./contracts": "./src/contracts/index.ts"
  }
}
