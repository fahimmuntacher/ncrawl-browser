# NCrawl Browser configuration. Copy to .env or export in your shell. No secrets belong here.

# Where project profiles (Chromium user-data dirs) and captures are stored.
# Profiles contain your logged-in sessions for target apps: keep this directory private and out of git.
NCRAWL_DATA_DIR=.ncrawl-data

# false = visible browser (required for manual login). true = no window (CI / explicit headless runs).
NCRAWL_HEADLESS=false

# Optional: use an installed Chrome/Edge instead of Playwright's pinned Chromium ("chrome", "msedge").
# NCRAWL_BROWSER_CHANNEL=chrome

# Navigation timeout per attempt (ms, 1000-300000) and retries for transient network errors (0-5).
NCRAWL_NAV_TIMEOUT_MS=30000
NCRAWL_NAV_RETRIES=2

# Default viewport for new sessions.
NCRAWL_VIEWPORT_WIDTH=1440
NCRAWL_VIEWPORT_HEIGHT=900

# debug | info | warn | error. Logs are JSON lines on stderr, with secrets redacted.
NCRAWL_LOG_LEVEL=info

# Port for the local mock ERP (npm run start -w @ncrawl/mock-erp).
MOCK_ERP_PORT=4600
